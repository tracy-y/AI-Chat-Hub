{
  "manifest_version": 3,
  "name": "AI Chat Hub PoC",
  "version": "0.3.1",
  "key": "",
  "description": "Local-first hub for direct answers through official subscription-backed agents.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage", "nativeMessaging"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open AI Chat Hub"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
